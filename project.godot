; SpiderWeb — Godot 4.7 project. Mobile renderer, landscape handheld.

config_version=5

[application]

config/name="SpiderWeb"
config/description="Unofficial fan traversal game. Not affiliated with Marvel."
run/main_scene="res://scenes/main/Boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/core/EventBus.gd"
SaveManager="*res://scripts/save/SaveManager.gd"
